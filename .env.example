# Root-level env — shared across services via docker-compose.
# Copy to .env and fill in. Per-service .env.example files hold service-specific vars.

# --- Postgres ---
POSTGRES_USER=archadi
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=archadi_pr_review
POSTGRES_PORT=5432

# --- Shared ports (local only — not used in prod compose) ---
WEB_PORT=3000
API_PORT=4000
AI_SERVICE_PORT=8000

# --- Environment ---
NODE_ENV=development
