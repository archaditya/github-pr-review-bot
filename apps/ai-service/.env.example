# apps/ai-service/.env — copy from this template

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# OpenAI (ADR-003)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_REQUEST_TIMEOUT_SECONDS=25

# Guardrails (app/core/config.py) — sane defaults, tune once real usage is observed
MAX_DIFF_TOKENS=12000
MAX_FINDINGS=50
MAX_CONVERSATION_HISTORY_MESSAGES=20
MAX_REPLY_CHARS=4000
MAX_REQUEST_BODY_BYTES=2097152
