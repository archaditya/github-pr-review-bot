# apps/api/.env — copy from this template

PORT=4000
NODE_ENV=development

# Database (Sequelize)
DATABASE_URL=postgres://archadi:change_me_locally@postgres:5432/archadi_pr_review

# Auth
JWT_SECRET=change_me
SESSION_COOKIE_NAME=archadi_session

# GitHub App (ADR-007)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=       # PEM contents, base64-encoded recommended for env storage
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=       # for user login (web dashboard), separate from the App's installation auth
GITHUB_OAUTH_CLIENT_SECRET=

# ai-service client
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_CB_FAILURE_THRESHOLD=5
AI_SERVICE_CB_RESET_TIMEOUT_MS=30000

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
