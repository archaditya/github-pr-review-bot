# apps/api/.env — copy from this template

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Database (Sequelize)
DATABASE_URL=postgres://archadi:change_me_locally@postgres:5432/archadi_pr_review

# Auth
JWT_SECRET=change_me
SESSION_COOKIE_NAME=archadi_session

# GitHub App (ADR-007) — repo access + webhooks
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=       # PEM contents, base64-encoded recommended for env storage
GITHUB_WEBHOOK_SECRET=
GITHUB_BOT_HANDLE=archadi-bot # used for the @mention reply trigger (ADR-009)

# GitHub OAuth — user login on the web dashboard, separate from the App's installation
# auth above (ADR-007). Register a standard "OAuth App" (not the same as the GitHub App)
# for this, or reuse the GitHub App's own OAuth credentials if it has them enabled.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/auth/github/callback

# ai-service client
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_CB_FAILURE_THRESHOLD=5
AI_SERVICE_CB_RESET_TIMEOUT_MS=30000

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
